{
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "$defs" : {
    "ProcessedPersonalDeviceUserType" : {
      "type" : "string",
      "enum" : [ "UNAVAILABLE", "APEDESTRIAN", "APEDALCYCLIST", "APUBLICSAFETYWORKER", "ANANIMAL" ]
    },
    "ProcessedValidationMessage" : {
      "type" : "object",
      "properties" : {
        "exception" : {
          "type" : "string"
        },
        "jsonPath" : {
          "type" : "string"
        },
        "message" : {
          "type" : "string"
        },
        "schemaPath" : {
          "type" : "string"
        }
      }
    },
    "PsmProperties" : {
      "type" : "object",
      "properties" : {
        "asn1" : {
          "type" : "string"
        },
        "basicType" : {
          "$ref" : "#/$defs/ProcessedPersonalDeviceUserType"
        },
        "heading" : {
          "type" : "number",
          "format" : "double"
        },
        "id" : {
          "type" : "string"
        },
        "messageType" : {
          "type" : "string"
        },
        "msgCnt" : {
          "type" : "integer",
          "format" : "int32"
        },
        "odeReceivedAt" : {
          "type" : "string"
        },
        "originIp" : {
          "type" : "string"
        },
        "schemaVersion" : {
          "type" : "integer",
          "format" : "int32"
        },
        "secMark" : {
          "type" : "integer",
          "format" : "int32"
        },
        "speed" : {
          "type" : "number",
          "format" : "double"
        },
        "timeStamp" : {
          "type" : "string",
          "format" : "date-time"
        },
        "validationMessages" : {
          "type" : "array",
          "items" : {
            "$ref" : "#/$defs/ProcessedValidationMessage"
          }
        }
      }
    },
    "LineString-1" : {
      "type" : "object",
      "properties" : {
        "bbox" : {
          "type" : "array",
          "items" : {
            "type" : "number",
            "format" : "double"
          }
        },
        "coordinates" : {
          "type" : "array",
          "items" : {
            "type" : "array",
            "items" : {
              "type" : "number",
              "format" : "double"
            }
          }
        }
      }
    },
    "LineString-2" : {
      "$ref" : "#/$defs/LineString-1",
      "type" : "object",
      "properties" : {
        "type" : {
          "const" : "LineString"
        }
      },
      "required" : [ "type" ]
    },
    "Polygon-1" : {
      "type" : "object",
      "properties" : {
        "bbox" : {
          "type" : "array",
          "items" : {
            "type" : "number",
            "format" : "double"
          }
        },
        "coordinates" : {
          "type" : "array",
          "items" : {
            "type" : "array",
            "items" : {
              "type" : "array",
              "items" : {
                "type" : "number",
                "format" : "double"
              }
            }
          }
        }
      }
    },
    "Polygon-2" : {
      "$ref" : "#/$defs/Polygon-1",
      "type" : "object",
      "properties" : {
        "type" : {
          "const" : "Polygon"
        }
      },
      "required" : [ "type" ]
    },
    "MultiLineString-1" : {
      "type" : "object",
      "properties" : {
        "bbox" : {
          "type" : "array",
          "items" : {
            "type" : "number",
            "format" : "double"
          }
        },
        "coordinates" : {
          "type" : "array",
          "items" : {
            "type" : "array",
            "items" : {
              "type" : "array",
              "items" : {
                "type" : "number",
                "format" : "double"
              }
            }
          }
        }
      }
    },
    "MultiLineString-2" : {
      "$ref" : "#/$defs/MultiLineString-1",
      "type" : "object",
      "properties" : {
        "type" : {
          "const" : "MultiLineString"
        }
      },
      "required" : [ "type" ]
    },
    "MultiPolygon-1" : {
      "type" : "object",
      "properties" : {
        "bbox" : {
          "type" : "array",
          "items" : {
            "type" : "number",
            "format" : "double"
          }
        },
        "coordinates" : {
          "type" : "array",
          "items" : {
            "type" : "array",
            "items" : {
              "type" : "array",
              "items" : {
                "type" : "array",
                "items" : {
                  "type" : "number",
                  "format" : "double"
                }
              }
            }
          }
        }
      }
    },
    "MultiPolygon-2" : {
      "$ref" : "#/$defs/MultiPolygon-1",
      "type" : "object",
      "properties" : {
        "type" : {
          "const" : "MultiPolygon"
        }
      },
      "required" : [ "type" ]
    }
  },
  "type" : "object",
  "properties" : {
    "geometry" : {
      "oneOf" : [ {
        "$ref" : "#/$defs/Point-2"
      }, {
        "$ref" : "#/$defs/LineString-2"
      }, {
        "$ref" : "#/$defs/Polygon-2"
      }, {
        "$ref" : "#/$defs/MultiLineString-2"
      }, {
        "$ref" : "#/$defs/MultiPolygon-2"
      } ]
    },
    "id" : {
      "type" : "integer",
      "format" : "int32"
    },
    "properties" : {
      "$ref" : "#/$defs/PsmProperties"
    }
  }
}